<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/jospar_widget_background"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false"
            android:text="СЕГОДНЯ"
            android:textColor="#0267AA"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/jospar_widget_progress_badge"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:minWidth="42dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="0 / 0"
            android:textColor="#0267AA"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:max="1"
        android:progress="0"
        android:progressTint="#0267AA"
        android:progressBackgroundTint="@color/jospar_widget_divider" />

    <LinearLayout
        android:id="@+id/widget_task_1"
        style="@style/JosparWidgetTaskRow">

        <ImageView
            android:id="@+id/widget_task_check_1"
            style="@style/JosparWidgetCheckbox" />

        <TextView
            android:id="@+id/widget_task_title_1"
            style="@style/JosparWidgetTaskTitle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_task_2"
        style="@style/JosparWidgetTaskRow">

        <ImageView
            android:id="@+id/widget_task_check_2"
            style="@style/JosparWidgetCheckbox" />

        <TextView
            android:id="@+id/widget_task_title_2"
            style="@style/JosparWidgetTaskTitle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_task_3"
        style="@style/JosparWidgetTaskRow">

        <ImageView
            android:id="@+id/widget_task_check_3"
            style="@style/JosparWidgetCheckbox" />

        <TextView
            android:id="@+id/widget_task_title_3"
            style="@style/JosparWidgetTaskTitle" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Ничего не запланировано"
        android:textColor="@color/jospar_widget_secondary_text"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/widget_add"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/jospar_widget_add_background"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="＋"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_add_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:includeFontPadding="false"
            android:text="ДОБАВИТЬ"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
